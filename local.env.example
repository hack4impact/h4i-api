# Local settings for developers (docs/LOCAL-DEVELOPMENT.md, step 3). Copy to local.env (git-ignored by *.env), fill in the
# secrets from the vault item "portal development", and run: ./gradlew bootRun -PenvFile=local.env
# Values may be JSON-quoted ("…"), which keeps multi-line keys on one line. Lines starting with # are ignored.
# Never put production credentials here: development uses the sandboxes only.

# Where browsers reach the app. The API on its own: 8080. Behind the frontend's dev server: 5173 for both (that
# redirect URI must be registered on the Google client: http://localhost:5173/login/oauth2/code/google).
PORTAL_BASE_URL=http://localhost:8080
PORTAL_FRONTEND_URL=http://localhost:8080
PORTAL_JOIN_BASE_URL=http://localhost:8080/join

# Email goes to the dev Mailpit (http://localhost:8026), started by bootRun.
PORTAL_MAIL_MODE=smtp
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1026

# Sign-in (needed). The development Google OAuth client and GitHub OAuth app.
PORTAL_GOOGLE_CLIENT_ID=<from the vault>.apps.googleusercontent.com
PORTAL_GOOGLE_CLIENT_SECRET=<from the vault>
PORTAL_GITHUBOAUTH_CLIENTID=<from the vault>
PORTAL_GITHUBOAUTH_CLIENTSECRET=<from the vault>

# Optional: the fake member database (started by bootRun) as a live integration. Writes stay off.
MEMBER_DB_URL=jdbc:postgresql://localhost:5433/memberdb
MEMBER_DB_USERNAME=memberdb
MEMBER_DB_PASSWORD=memberdb
PORTAL_MEMBERDB_PULL=false

# Stage 2's tools, all off. Turn one on with its ENABLED (reads only, in dry run); writes need its WRITE as well and
# change the shared sandbox for everyone, so leave WRITE to the sandbox suite (scripts/sandbox-e2e.sh).
# Vaultwarden and Documenso have no shared sandbox: scripts/sandbox-setup.sh starts local ones and writes their
# settings to deploy/sandbox/sandbox.env (pass it as a second env file, or copy its lines here).

# Slack: the sandbox workspace's app.
PORTAL_ADAPTERS_SLACK_ENABLED=false
PORTAL_ADAPTERS_SLACK_BOTTOKEN=<from the vault: xoxb-…>

# GitHub: the sandbox organization and its GitHub App. The private key inline (JSON-quoted PEM) or as a file path.
PORTAL_ADAPTERS_GITHUB_ENABLED=false
PORTAL_ADAPTERS_GITHUB_ORG=<from the vault>
PORTAL_ADAPTERS_GITHUB_APPID=<from the vault>
PORTAL_ADAPTERS_GITHUB_INSTALLATIONID=<from the vault>
PORTAL_ADAPTERS_GITHUB_PRIVATEKEY=<from the vault>

# Google: the /Portal Sandbox org unit, through the service account with domain-wide delegation. The key inline
# (JSON-quoted) or as a file path. GROUPSCOPE keeps real groups out; USERSCOPE limits created accounts to the sandbox.
PORTAL_ADAPTERS_GOOGLE_ENABLED=false
PORTAL_ADAPTERS_GOOGLE_CREATEACCOUNTS=false
PORTAL_ADAPTERS_GOOGLE_ADMINSUBJECT=<from the vault>
PORTAL_ADAPTERS_GOOGLE_SERVICEACCOUNTKEY=<from the vault>
PORTAL_ADAPTERS_GOOGLE_ORGUNITPATH=/Portal Sandbox
PORTAL_ADAPTERS_GOOGLE_GROUPSCOPE=<from the vault>
PORTAL_ADAPTERS_GOOGLE_USERSCOPE=<from the vault>
